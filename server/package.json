  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "start": "nodemon server.js",
    "dev": "nodemon server.js",
    "migrate": "node-pg-migrate --envPath .env --database-url-var DATABASE_URL",
    "migrate:up": "npm run migrate -- up",
    "migrate:deploy": "node-pg-migrate --database-url-var DATABASE_URL up",
    "migrate:down": "npm run migrate -- down",
    "migrate:test": "node-pg-migrate --envPath .env --database-url-var MIGRATION_TEST_DATABASE_URL",
    "migrate:test:up": "npm run migrate:test -- up",
    "migrate:test:down": "npm run migrate:test -- down"
  },
